<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OfficeSupportToolHarness</RootNamespace>
    <MSBuildCopyContentTransitively>false</MSBuildCopyContentTransitively>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeSupportTool.csproj" />
    <ProjectReference Include="..\..\AIOrchestrator\AIOrchestrator.csproj" />
  </ItemGroup>

  <!-- The plugin ships its templates into assets/templates/; the harness needs them in its own
       output (AppContext.BaseDirectory) because the plugin resolves them at runtime. -->
  <ItemGroup>
    <None Include="..\Assets\*.html" Link="assets\templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\TEMPLATE-GUIDELINES.md" Link="assets\template-guidelines.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
